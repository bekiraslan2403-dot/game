{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akköprü 2026",
  "version": "0.2.0",
  "identifier": "com.bekiraslan.akkopru2026",
  "mainBinaryName": "akkopru",
  "build": {
    "beforeDevCommand": "npm run derle",
    "beforeBuildCommand": "npm run derle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Akköprü 2026",
      "width": 1366,
      "height": 900,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Game",
    "shortDescription": "Doruk Cumhuriyeti'nde 18 aylık iktidar mücadelesi.",
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
